{
  "_comment": "LG.com 페이지 타입 정의. 우선순위: meta_template → body_class → url_pattern. 첫 매칭 타입이 결정. 순서가 중요 — 특정도 높은 순으로 배치.",
  "page_types": [
    {
      "id": "home",
      "label": "홈페이지",
      "detection": {
        "meta_template": ["home-page", "homepage"],
        "body_class":    ["homepage"],
        "url_pattern":   ["^https?://[^/]+/?$", "^https?://[^/]+/[a-z]{2}/?$"]
      },
      "expected_schemas":    ["Organization", "WebSite"],
      "recommended_schemas": ["BreadcrumbList"]
    },
    {
      "id": "pdp",
      "label": "제품 상세 (PDP)",
      "detection": {
        "meta_template": ["pdp-page", "product-page"],
        "body_class":    ["productpage", "pdp"]
      },
      "expected_schemas":    ["Product", "BreadcrumbList"],
      "recommended_schemas": ["Offer", "AggregateRating", "Review"]
    },
    {
      "id": "plp",
      "label": "제품 카테고리 (PLP)",
      "detection": {
        "meta_template": ["plp-page", "category-page", "product-listing-page"],
        "body_class":    ["plppage", "categorypage", "productlistingpage"]
      },
      "expected_schemas":    ["ItemList", "BreadcrumbList"],
      "recommended_schemas": ["CollectionPage"]
    },
    {
      "id": "support",
      "label": "지원/Support",
      "detection": {
        "meta_template": ["support-page-template", "support-page"],
        "body_class":    ["support"],
        "url_pattern":   ["/[a-z]{2}/support(/|$)"]
      },
      "expected_schemas":    ["BreadcrumbList"],
      "recommended_schemas": ["FAQPage"]
    },
    {
      "id": "business",
      "label": "B2B (사업자)",
      "detection": {
        "url_pattern": ["/[a-z]{2}/business(/|$)"]
      },
      "expected_schemas":    ["Product", "BreadcrumbList"],
      "recommended_schemas": ["Offer"]
    },
    {
      "id": "content",
      "label": "콘텐츠/매거진",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}/lg-experience(/|$)",
          "/[a-z]{2}/magazine(/|$)",
          "/[a-z]{2}/lifesgood(/|$)",
          "/[a-z]{2}/monthly-lg(/|$)"
        ]
      },
      "expected_schemas":    ["Article"],
      "recommended_schemas": ["BreadcrumbList", "Author"]
    },
    {
      "id": "promotion",
      "label": "프로모션/약관",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}/promotion(/|$)",
          "/[a-z]{2}/tncs(/|$)"
        ]
      },
      "expected_schemas":    ["WebPage"],
      "recommended_schemas": ["BreadcrumbList"]
    },
    {
      "id": "about",
      "label": "회사/About",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}/about-lg(/|$)",
          "/[a-z]{2}/about(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "AboutPage"],
      "recommended_schemas": ["BreadcrumbList"]
    },
    {
      "id": "newsroom",
      "label": "뉴스룸/Press",
      "detection": {
        "meta_template": ["newsroom-page", "press-page"],
        "body_class":    ["newsroom", "presspage"],
        "url_pattern":   ["/newsroom(/|$)", "/press-media(/|$)", "/press-release(/|$)"]
      },
      "expected_schemas":    ["NewsArticle", "Organization"],
      "recommended_schemas": ["BreadcrumbList"]
    },
    {
      "id": "buying_guide",
      "label": "구매 가이드",
      "detection": {
        "url_pattern": [
          "[/-]buying-guides?(/|$)"
        ]
      },
      "expected_schemas":    ["Article", "BreadcrumbList"],
      "recommended_schemas": ["HowTo"]
    },
    {
      "id": "microsite",
      "label": "마이크로사이트/캠페인",
      "_comment": "캠페인성 페이지(aidd-laundry 등) 또는 블로그성 글(why-/what-/how-/best- 슬러그). 다른 타입 미매칭일 때 매칭.",
      "detection": {
        "meta_template": ["page-content"],
        "url_pattern": [
          "/(why|what|how|best|top|which|when|where)-[a-z]",
          "-vs-[a-z]",
          "/blog(/|$)"
        ]
      },
      "expected_schemas":    ["Article", "BreadcrumbList"],
      "recommended_schemas": ["Author", "WebPage"]
    },
    {
      "id": "unknown",
      "label": "분류 불가",
      "detection": null,
      "expected_schemas":    [],
      "recommended_schemas": []
    }
  ]
}
