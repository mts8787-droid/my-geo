{
  "_comment": "LG.com 페이지 타입 정의. 우선순위: meta_template → body_class → url_pattern. 첫 매칭 타입이 결정. 순서가 중요 — 특정도 높은 순으로 배치.",
  "page_types": [
    {
      "id": "home",
      "label": "홈페이지",
      "detection": {
        "meta_template": ["home-page", "homepage"],
        "body_class":    ["homepage"],
        "url_pattern":   ["^https?://[^/]+/?$", "^https?://[^/]+/[a-z]{2}(?:[_-][a-z]{2})?/?$"]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "WebSite"],
      "recommended_schemas": []
    },
    {
      "id": "pdp",
      "label": "제품 상세 (PDP)",
      "detection": {
        "meta_template": ["pdp-page", "product-page"],
        "body_class":    ["productpage", "pdp"],
        "url_pattern":   [
          "/us/(?!support|business|press)[^/]+/lg-[a-zA-Z0-9]",
          "/(?!us/)[a-z]{2}(?:[_-][a-z]{2})?/(?!(?:support|soporte|suporte|tro-giup|business|about-lg|about|acerca-de-lg|sobre-a-lg|uber-lg|ueber-lg|gioi-thieu-lg|promotion|promociones|todas-las-promociones|promocoes|promotions|teilnahmebedingungen|khuyen-mai|tncs|lifesgood|magazine|lg-experience|experience|discover|monthly-lg|blog|press-release|press-media|newsroom|historias-con-lg|historias-com-lg|contact-us)(?:/|\\?|$))(?!.*-vs-)(?!.*buying-guides?(?:/|$))(?!.*/(?:why|what|how|best|top|which|when|where)-)(?:[a-z0-9-]+/){1,4}[a-z0-9]*\\d[a-z0-9-]*/?(?:[?#].*)?$"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "Product", "Offer", "AggregateRating", "Review", "FAQPage", "HowTo", "ImageObject", "VideoObject"],
      "recommended_schemas": []
    },
    {
      "id": "plp",
      "label": "제품 카테고리 (PLP)",
      "detection": {
        "meta_template": ["plp-page", "category-page", "product-listing-page"],
        "body_class":    ["plppage", "categorypage", "productlistingpage"],
        "url_pattern":   [
          "^https?://[^/]+/us/(?!(?:support|business|about-lg|about|promotion|promotions|tncs|lifesgood|magazine|lg-experience|experience|discover|monthly-lg|blog|press-release|press-media|newsroom)(?:/|\\?|$))(?!(?:why|what|how|best|top|which|when|where)-)(?!.*-vs-)(?!.*buying-guides?(?:/|$))[a-z0-9-]+/?$",
          "/us/collections/",
          "/us/[^/]+/discontinued(/|$)",
          "/(?!us/)[a-z]{2}(?:[_-][a-z]{2})?/(?!(?:support|soporte|suporte|tro-giup|business|about-lg|about|acerca-de-lg|sobre-a-lg|uber-lg|ueber-lg|gioi-thieu-lg|promotion|promociones|todas-las-promociones|promocoes|promotions|teilnahmebedingungen|khuyen-mai|tncs|lifesgood|magazine|lg-experience|experience|discover|monthly-lg|blog|press-release|press-media|newsroom|historias-con-lg|historias-com-lg|contact-us)(?:/|\\?|$))(?!.*-vs-)(?!.*buying-guides?(?:/|$))(?!.*/(?:why|what|how|best|top|which|when|where)-)(?:[a-z0-9-]+/){0,3}[a-z][a-z-]*/?(?:[?#].*)?$"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "ItemList", "CollectionPage"],
      "recommended_schemas": []
    },
    {
      "id": "support_troubleshoot",
      "label": "지원 - 트러블슈팅",
      "_comment": "support 안에서 트러블슈팅/help-library 콘텐츠. support보다 먼저 매칭되어야 우선 적용됨.",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}(?:[_-][a-z]{2})?/(support|soporte|suporte|tro-giup)/(?:.*?/)?troubleshoot(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/(support|soporte|suporte|tro-giup)/(?:.*?/)?help-library(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "HowTo"],
      "recommended_schemas": []
    },
    {
      "id": "support",
      "label": "지원/Support",
      "detection": {
        "meta_template": ["support-page-template", "support-page"],
        "body_class":    ["support"],
        "url_pattern":   ["/[a-z]{2}(?:[_-][a-z]{2})?/(support|soporte|suporte|tro-giup)(/|$)"]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList"],
      "recommended_schemas": []
    },
    {
      "id": "business",
      "label": "B2B (사업자)",
      "detection": {
        "url_pattern": ["/[a-z]{2}(?:[_-][a-z]{2})?/business(/|$)"]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "Product", "Offer"],
      "recommended_schemas": []
    },
    {
      "id": "content",
      "label": "콘텐츠/매거진",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}(?:[_-][a-z]{2})?/lg-experience(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/experience(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/discover(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/magazine(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/lifesgood(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/monthly-lg(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/(historias-con-lg|historias-com-lg)(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "Article", "Person", "ImageObject", "VideoObject"],
      "recommended_schemas": []
    },
    {
      "id": "newsroom",
      "label": "뉴스룸/Press",
      "_comment": "about/promotion보다 먼저 매칭 — press-media가 /sobre-a-lg/ 등 about 하위에 중첩될 때 newsroom이 우선.",
      "detection": {
        "meta_template": ["newsroom-page", "press-page"],
        "body_class":    ["newsroom", "presspage"],
        "url_pattern":   ["/newsroom(/|$)", "/press-media(/|$)", "/press-release(/|$)"]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "NewsArticle", "Person", "ImageObject", "VideoObject"],
      "recommended_schemas": []
    },
    {
      "id": "promotion",
      "label": "프로모션/약관",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}(?:[_-][a-z]{2})?/promotion(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/tncs(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/(promociones|todas-las-promociones|promocoes|promotions|teilnahmebedingungen|khuyen-mai)(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "WebPage", "Offer"],
      "recommended_schemas": []
    },
    {
      "id": "about",
      "label": "회사/About",
      "detection": {
        "url_pattern": [
          "/[a-z]{2}(?:[_-][a-z]{2})?/about-lg(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/about(/|$)",
          "/[a-z]{2}(?:[_-][a-z]{2})?/(acerca-de-lg|sobre-a-lg|uber-lg|ueber-lg|gioi-thieu-lg)(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "AboutPage"],
      "recommended_schemas": []
    },
    {
      "id": "buying_guide",
      "label": "구매 가이드",
      "detection": {
        "url_pattern": [
          "[/-]buying-guides?(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "FAQPage", "HowTo", "Article"],
      "recommended_schemas": []
    },
    {
      "id": "microsite",
      "label": "마이크로사이트/캠페인",
      "_comment": "캠페인성 페이지(aidd-laundry 등) 또는 블로그성 글(why-/what-/how-/best- 슬러그). 다른 타입 미매칭일 때 매칭.",
      "detection": {
        "meta_template": ["page-content"],
        "url_pattern": [
          "/(why|what|how|best|top|which|when|where)-[a-z]",
          "-vs-[a-z]",
          "/blog(/|$)"
        ]
      },
      "expected_schemas":    ["Organization", "BreadcrumbList", "WebPage", "FAQPage", "HowTo", "Article", "Person", "ImageObject", "VideoObject"],
      "recommended_schemas": []
    },
    {
      "id": "unknown",
      "label": "분류 불가",
      "detection": null,
      "expected_schemas":    [],
      "recommended_schemas": []
    }
  ]
}
